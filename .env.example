# ---- Public (browser) ----
# Base URL the admin UI uses to reach the API. Same-origin "/api" in Option B.
NEXT_PUBLIC_API_URL=/api

# ---- Firebase Admin (server only) ----
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Keep the quotes; escaped newlines (\n) are supported.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- Auth (Firebase Authentication) ----
# Web API key (Firebase console → Project settings → General) for server-side
# email/password sign-in via the Identity Toolkit REST API.
FIREBASE_API_KEY=
# Session cookie lifetime in days (max 14).
SESSION_DAYS=5
# Set in production to share the session across subdomains (manage.* / api.*).
# Leave empty for localhost.
COOKIE_DOMAIN=

# ---- CORS ----
# Comma-separated list of allowed origins for the public API (landing + admin).
CORS_ORIGIN=https://msspsuhatyai.org,https://manage.msspsuhatyai.org,http://localhost:3005

# ---- Cloudflare R2 storage ----
R2_REGION=auto
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com/
R2_BUCKET=msspsu
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_DOMAIN=https://pub-xxxx.r2.dev

# ---- Cloudflare Web Analytics (optional; /api/cloudflare/analytics) ----
CF_API_TOKEN=
CF_ZONE_ID=
